TASK_ID=FSE-2025-009
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/gleipner:/shared/gleipner:ro
ENV_IN_CONTAINER_GLEIPNER_HOME=/shared/gleipner
ENV_IN_CONTAINER_JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV_IN_CONTAINER_JAVA8_HOME=/usr/lib/jvm/java-8-openjdk-amd64
ENV_IN_CONTAINER_PATH=/opt/fse-2025-009-venv/bin:/usr/lib/jvm/java-11-openjdk-amd64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Install JDK8 + ensure Maven/g++/Python via seeds/container_setup.sh on container start.
CONTAINER_SETUP=true
