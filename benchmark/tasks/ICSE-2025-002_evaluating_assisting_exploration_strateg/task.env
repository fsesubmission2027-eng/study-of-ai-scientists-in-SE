TASK_ID=ICSE-2025-002
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/fuzzing-empirical-study:/shared/fuzzing-empirical-study:ro
ENV_IN_CONTAINER_FUZZING_EMPIRICAL_STUDY_HOME=/shared/fuzzing-empirical-study
ENV_IN_CONTAINER_PATH=/opt/icse-2025-002-venv/bin:/usr/lib/llvm-13/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Install LLVM-13, AFL++, build deps + Python via seeds/container_setup.sh on container start.
CONTAINER_SETUP=true
