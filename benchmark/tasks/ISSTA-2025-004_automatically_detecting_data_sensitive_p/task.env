TASK_ID=ISSTA-2025-004
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/hulk-issta2025-baselines:/shared/hulk-issta2025-baselines:ro
ENV_IN_CONTAINER_HULK_ISSTA2025_BASELINES_HOME=/shared/hulk-issta2025-baselines
ENV_IN_CONTAINER_APOLLO_HOME=/shared/hulk-issta2025-baselines/apollo
ENV_IN_CONTAINER_SQLANCER_HOME=/shared/hulk-issta2025-baselines/sqlancer
ENV_IN_CONTAINER_SQUIRREL_HOME=/shared/hulk-issta2025-baselines/squirrel
ENV_IN_CONTAINER_PATH=/opt/issta-2025-004-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Java (SQLancer) + Python analysis + MySQL/Postgres client libs via seeds/container_setup.sh
# Full MySQL/MariaDB/Percona/TiDB/PostgreSQL/AntDB server builds are NOT preinstalled.
CONTAINER_SETUP=true
