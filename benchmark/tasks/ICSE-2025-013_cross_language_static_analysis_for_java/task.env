TASK_ID=ICSE-2025-013
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=48g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/jnifer-subjects:/shared/jnifer-subjects:ro
ENV_IN_CONTAINER_JNIFER_SUBJECTS_HOME=/shared/jnifer-subjects
ENV_IN_CONTAINER_OPENJDK8_HOME=/shared/jnifer-subjects/subjects/openjdk8
ENV_IN_CONTAINER_ASPECTJ_HOME=/shared/jnifer-subjects/subjects/aspectj-1.6.9
ENV_IN_CONTAINER_LUCENE_HOME=/shared/jnifer-subjects/subjects/lucene-4.3.0
ENV_IN_CONTAINER_TOMCAT_NATIVE_HOME=/shared/jnifer-subjects/subjects/tomcat-native-1.2.23
ENV_IN_CONTAINER_LOG4J_HOME=/shared/jnifer-subjects/subjects/log4j-1.2.16
ENV_IN_CONTAINER_PATH=/opt/icse-2025-013-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# OpenJDK + Maven + C/C++ build deps via seeds/container_setup.sh
CONTAINER_SETUP=true
