ENV_IN_CONTAINER_ASV_SRC=/shared/asvtestscenegeneration-issta2025/src
ENV_IN_CONTAINER_PATH=/opt/issta-2025-008-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# pymoo / Scenic / Shapely COLREGS scene-generation stack via seeds/container_setup.sh
# High-fidelity maritime simulators (MOOS-IvP / ArduPilot SITL) are NOT preinstalled.
CONTAINER_SETUP=true
