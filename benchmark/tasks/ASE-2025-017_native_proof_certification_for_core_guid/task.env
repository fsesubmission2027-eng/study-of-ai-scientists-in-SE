TASK_ID=ASE-2025-017
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/maxsat2024:/shared/maxsat2024:ro
ENV_IN_CONTAINER_MAXSAT2024_HOME=/shared/maxsat2024
ENV_IN_CONTAINER_EVALMAXSAT_HOME=/opt/ase-2025-017-tools/EvalMaxSAT
ENV_IN_CONTAINER_PATH=/opt/ase-2025-017-venv/bin:/opt/ase-2025-017-tools/bin:/opt/ase-2025-017-tools/EvalMaxSAT/build:/opt/ase-2025-017-tools/EvalMaxSAT/build/main:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# C++ toolchain + EvalMaxSAT + Python analysis env at container start.
CONTAINER_SETUP=true
