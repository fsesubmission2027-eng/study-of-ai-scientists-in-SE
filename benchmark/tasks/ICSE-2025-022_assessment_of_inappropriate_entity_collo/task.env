TASK_ID=ICSE-2025-022
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/pairsmell:/shared/pairsmell:ro
ENV_IN_CONTAINER_PAIRSMELL_HOME=/shared/pairsmell
ENV_IN_CONTAINER_PATH=/opt/icse-2025-022-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Analysis stack (pandas/networkx/pydriller/...) via seeds/container_setup.sh
CONTAINER_SETUP=true
