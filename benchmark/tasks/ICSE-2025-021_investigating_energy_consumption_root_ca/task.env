TASK_ID=ICSE-2025-021
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/energydebug-icse2025:/shared/energydebug-icse2025:ro
ENV_IN_CONTAINER_ENERGYDEBUG_HOME=/shared/energydebug-icse2025
ENV_IN_CONTAINER_ENERGYDEBUG_DATA_HOME=/shared/energydebug-icse2025/data
ENV_IN_CONTAINER_ENERGYDEBUG_NOTEBOOK=/shared/energydebug-icse2025/energydebug.ipynb
ENV_IN_CONTAINER_ENERGYDEBUG_DOCKER_HOME=/shared/energydebug-icse2025/docker
ENV_IN_CONTAINER_PATH=/opt/icse-2025-021-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Analysis stack (numpy/pandas/scipy/statsmodels/jupyter) via seeds/container_setup.sh
CONTAINER_SETUP=true
