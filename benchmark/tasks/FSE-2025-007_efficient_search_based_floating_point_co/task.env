TASK_ID=FSE-2025-007
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/qsf:/shared/qsf:ro
ENV_IN_CONTAINER_QSF_HOME=/shared/qsf
ENV_IN_CONTAINER_PATH=/opt/fse-2025-007-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Install Z3/LLVM/Python toolchain via seeds/container_setup.sh on container start.
CONTAINER_SETUP=true
