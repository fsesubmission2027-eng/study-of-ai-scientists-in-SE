TASK_ID=ISSTA-2025-002
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/routhsearch-issta2025:/shared/routhsearch-issta2025:ro
ENV_IN_CONTAINER_ROUTHSEARCH_HOME=/shared/routhsearch-issta2025
ENV_IN_CONTAINER_ROUTHSEARCH_SEARCH=/shared/routhsearch-issta2025/routh_search
ENV_IN_CONTAINER_ROUTHSEARCH_EVAL=/shared/routhsearch-issta2025/evaluation_script
ENV_IN_CONTAINER_ROUTHSEARCH_DEFAULT_DATA=/shared/routhsearch-issta2025/ardupilot_default_data
ENV_IN_CONTAINER_PATH=/opt/issta-2025-002-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Python + pymavlink oracle/analysis stack via seeds/container_setup.sh
# Full ArduPilot SITL + PX4 jMAVSim are NOT installed here (host/bare-metal).
CONTAINER_SETUP=true
