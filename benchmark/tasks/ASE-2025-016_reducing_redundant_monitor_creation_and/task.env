TASK_ID=ASE-2025-016
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/valg:/shared/valg:ro
ENV_IN_CONTAINER_VALG_HOME=/shared/valg
ENV_IN_CONTAINER_JAVA_HOME=/usr/lib/jvm/java-8-openjdk
ENV_IN_CONTAINER_ASPECTJ_HOME=/opt/ase-2025-016-tools/aspectj-1.9.7
ENV_IN_CONTAINER_M2_HOME=/opt/ase-2025-016-tools/apache-maven
ENV_IN_CONTAINER_MAVEN_HOME=/opt/ase-2025-016-tools/apache-maven
ENV_IN_CONTAINER_PATH=/opt/ase-2025-016-venv/bin:/opt/ase-2025-016-tools/apache-maven/bin:/opt/ase-2025-016-tools/aspectj-1.9.7/bin:/usr/lib/jvm/java-8-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Create a disposable Java 8 + Maven + Python analysis env at container start.
CONTAINER_SETUP=true
