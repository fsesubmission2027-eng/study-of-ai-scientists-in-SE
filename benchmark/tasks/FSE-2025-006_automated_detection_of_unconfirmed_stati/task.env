TASK_ID=FSE-2025-006
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
# Install Python/R scientific stack + Jupyter + Kaggle CLI via seeds/container_setup.sh
CONTAINER_SETUP=true
# Host Kaggle credentials (optional). Put token at ~/.kaggle/kaggle.json
# https://www.kaggle.com/settings → API → Create New Token
EXTRA_VOLUME_1=~/.kaggle:/shared/kaggle:ro
ENV_IN_CONTAINER_KAGGLE_CONFIG_DIR=/shared/kaggle
# KAGGLE_API_TOKEN is injected globally via ai_scientist_benchmark/benchmark_credentials.yaml
