TASK_ID=FSE-2025-010
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/pinning-is-futile:/shared/pinning-is-futile:ro
ENV_IN_CONTAINER_PINNING_IS_FUTILE_HOME=/shared/pinning-is-futile
ENV_IN_CONTAINER_PATH=/opt/fse-2025-010-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Install Node/npm + Python (and light R) via seeds/container_setup.sh on container start.
CONTAINER_SETUP=true
