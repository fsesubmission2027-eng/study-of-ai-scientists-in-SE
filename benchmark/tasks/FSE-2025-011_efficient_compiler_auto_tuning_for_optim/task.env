TASK_ID=FSE-2025-011
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=172800
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/pdcat-master:/shared/pdcat-master:ro
ENV_IN_CONTAINER_PDCAT_HOME=/shared/pdcat-master
ENV_IN_CONTAINER_GCC=/usr/bin/gcc
ENV_IN_CONTAINER_PATH=/opt/fse-2025-011-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Install GCC toolchain + Python via seeds/container_setup.sh on container start.
CONTAINER_SETUP=true
