TASK_ID=ICSE-2025-008
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=40g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/perf-regression-early-detect:/shared/perf-regression-early-detect:ro
ENV_IN_CONTAINER_PERF_REGRESSION_EARLY_DETECT_HOME=/shared/perf-regression-early-detect
ENV_IN_CONTAINER_TEASTORE_HOME=/shared/perf-regression-early-detect/TeaStore
ENV_IN_CONTAINER_TRAINTICKET_HOME=/shared/perf-regression-early-detect/train-ticket
ENV_IN_CONTAINER_JMETER_HOME=/shared/perf-regression-early-detect/tools/apache-jmeter
ENV_IN_CONTAINER_PATH=/opt/icse-2025-008-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# OpenJDK + Maven + Docker CLI/Compose + JMeter deps via seeds/container_setup.sh
CONTAINER_SETUP=true
