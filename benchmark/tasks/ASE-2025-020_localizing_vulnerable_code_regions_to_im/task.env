TASK_ID=ASE-2025-020
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/losver:/shared/losver:ro
ENV_IN_CONTAINER_LOSVER_HOME=/shared/losver
ENV_IN_CONTAINER_DEVIGN_HOME=/shared/losver/datasets/devign
ENV_IN_CONTAINER_BIGVUL_HOME=/shared/losver/datasets/bigvul
ENV_IN_CONTAINER_PRIMEVUL_HOME=/shared/losver/datasets/primevul
ENV_IN_CONTAINER_LOSVER_REPOS=/shared/losver/repos
ENV_IN_CONTAINER_PATH=/opt/ase-2025-020-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Create a disposable Python + CPU-torch/transformers env at container start.
CONTAINER_SETUP=true
