TASK_ID=FSE-2025-001
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/defects4j:/shared/defects4j:ro
ENV_IN_CONTAINER_DEFECTS4J_HOME=/shared/defects4j
ENV_IN_CONTAINER_JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV_IN_CONTAINER_PERL5LIB=/shared/defects4j/perl-local/lib/perl5:/shared/defects4j/perl-local/lib/perl5/x86_64-linux-gnu-thread-multi
ENV_IN_CONTAINER_PATH=/shared/defects4j/framework/bin:/usr/lib/jvm/java-11-openjdk-amd64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
