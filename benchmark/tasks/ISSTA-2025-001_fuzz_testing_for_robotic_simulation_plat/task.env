TASK_ID=ISSTA-2025-001
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/gzfuzz-issta2025:/shared/gzfuzz-issta2025:ro
ENV_IN_CONTAINER_GZFUZZ_HOME=/shared/gzfuzz-issta2025
ENV_IN_CONTAINER_GZFUZZ_DATA=/shared/gzfuzz-issta2025/data
ENV_IN_CONTAINER_GZFUZZ_SRC=/shared/gzfuzz-issta2025/src
ENV_IN_CONTAINER_PATH=/opt/issta-2025-001-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Python + CPU-torch GzFuzz analysis stack via seeds/container_setup.sh
# Full Gazebo 8.0.0 fuzz campaigns are NOT installed here (host/bare-metal).
CONTAINER_SETUP=true
