TASK_ID=ISSTA-2025-009
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/llm4szz-issta2025:/shared/llm4szz-issta2025:ro
ENV_IN_CONTAINER_LLM4SZZ_HOME=/shared/llm4szz-issta2025/package
ENV_IN_CONTAINER_DS_HOME=/shared/llm4szz-issta2025/dataset
ENV_IN_CONTAINER_DS_LINUX=/shared/llm4szz-issta2025/dataset/DS_LINUX.json
ENV_IN_CONTAINER_DS_GITHUB=/shared/llm4szz-issta2025/dataset/DS_GITHUB.json
ENV_IN_CONTAINER_DS_APACHE=/shared/llm4szz-issta2025/dataset/DS_APACHE.json
ENV_IN_CONTAINER_PATH=/opt/issta-2025-009-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# GitPython + tree-sitter + OpenAI client stack via seeds/container_setup.sh
# Local Llama-3 weights / NeuralSZZ GPU training / full subject git clones are NOT preinstalled.
CONTAINER_SETUP=true
