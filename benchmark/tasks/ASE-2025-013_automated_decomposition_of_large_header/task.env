TASK_ID=ASE-2025-013
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=86400
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/hfdecomposer:/shared/hfdecomposer:ro
ENV_IN_CONTAINER_HFDECOMPOSER_HOME=/shared/hfdecomposer
ENV_IN_CONTAINER_PATH=/opt/ase-2025-013-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Create a disposable Python environment and install header-decomposition deps at container start.
CONTAINER_SETUP=true
