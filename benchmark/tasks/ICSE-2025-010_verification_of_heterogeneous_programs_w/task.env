TASK_ID=ICSE-2025-010
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=64g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/hetrify-svcomp:/shared/hetrify-svcomp:ro
ENV_IN_CONTAINER_HETRIFY_SVCOMP_HOME=/shared/hetrify-svcomp
ENV_IN_CONTAINER_SVCOMP24_HOME=/shared/hetrify-svcomp/svcomp24
ENV_IN_CONTAINER_SVCOMP23_HOME=/shared/hetrify-svcomp/svcomp23
ENV_IN_CONTAINER_CBMC_DEB=/shared/hetrify-svcomp/tools/cbmc.deb
ENV_IN_CONTAINER_PATH=/opt/icse-2025-010-venv/bin:/opt/cbmc/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# CBMC + RISC-V GCC + optional Ghidra deps via seeds/container_setup.sh
CONTAINER_SETUP=true
