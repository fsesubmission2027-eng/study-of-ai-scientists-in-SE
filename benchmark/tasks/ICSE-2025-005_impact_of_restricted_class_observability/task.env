TASK_ID=ICSE-2025-005
PROFILE=base
IMAGE=ai-scientist-base:20260615
TIMEOUT_SEC=2592000
MEMORY=32g
CPUS=8
REQUIRES_GPU=false
REQUIRES_HARDWARE=false
BENCHMARK_TIER=include
WORKPLACE_CONTAINER_PATH=/workplace
EXTRA_VOLUME_1=~/ai_scientist_inputs/shared_datasets/sf110-evosuite:/shared/sf110-evosuite:ro
