ENV_IN_CONTAINER_PATH=/opt/icse-2025-005-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# OpenJDK + Maven + EvoSuite deps via seeds/container_setup.sh
CONTAINER_SETUP=true
